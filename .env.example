# Copy this file to `.env` (which is git-ignored) and fill in your key.
# CLI commands (`ingest.embed_index`, `retrieve`) load `.env` automatically.

# -- Google AI Studio API key (free tier: https://aistudio.google.com/apikey) --
GEMINI_API_KEY=

# -- Dense retrieval / embeddings ---------------------------------------------
# Provider: gemini (API, no local model download) | local (offline multilingual-e5-small)
ROBOG_EMBED_PROVIDER=gemini

# Gemini embedding model ID (override if your AI Studio tier exposes e.g.
# gemini-embedding-2-preview or gemini-embedding-001)
ROBOG_EMBED_MODEL=gemini-embedding-2

# Output vector dimensions for Gemini (Matryoshka 128..3072; recommended: 1536)
ROBOG_EMBED_DIMS=1536

# Free-tier tokens-per-minute pacer (Google AI Studio free limit is 30,000 TPM;
# set to 0 if using a paid tier with higher limits)
ROBOG_EMBED_TPM=25000

# Persisted Chroma vector store path & collection name
ROBOG_CHROMA_PATH=build/chroma
ROBOG_CHROMA_COLLECTION=robog

# -- API server (uvicorn api.app:app / python -m api) -------------------------
# auto: fuse the Chroma index above when it exists (keyword-only otherwise;
# GET /health -> vector_active / vector_detail tells you which). off: never.
ROBOG_API_VECTOR=auto

# -- Answer composition (phase 3) ---------------------------------------------
# Provider: gemini (API, needs the key above) | offline (deterministic grounded
# formatter -- always available, no key, no network, used automatically as a
# fallback if the API fails). Leave as "auto" to use Gemini when it is configured.
ROBOG_LLM_PROVIDER=auto

# Answering model. gemini-2.5-flash now returns 404 for new keys; 3.8 Flash is
# Google's recommended replacement. Change here if your AI Studio key lists another.
# If this names a model your key cannot call, Robog switches to one that answers
# and says so (python -m answer --check, GET /health -> provider.model_note).
ROBOG_LLM_MODEL=gemini-3.8-flash

# Check the two settings above with one real call (prints the model's reply, or
# the API's error and the model IDs your key can use):
#   python -m answer --check

# Evidence check on generated answers. Default (unset/0): a number or citation
# that is not in the manuals discards the answer; a sentence without a source
# (a transition, "the manuals don't cover that") is kept and reported as
# uncited. 1: any sentence without a source discards the generated answer and
# the offline formatter quotes the passages instead.
ROBOG_ANSWER_STRICT=0
