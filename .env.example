# RoboGuide backend. Leave VITE_ROBOGUIDE_API_URL empty to run in clearly-labelled demo (mock) mode.
VITE_ROBOGUIDE_API_URL=
# Path of the question endpoint (POST), appended to the URL above.
VITE_ROBOGUIDE_ASK_PATH=/ask
# Set to "true" to force demo mode even when a URL is set.
VITE_ROBOGUIDE_MOCK=false
# Request timeout in ms.
VITE_ROBOGUIDE_TIMEOUT_MS=60000
# Values sent in the request "mode" field.
VITE_ROBOGUIDE_MODE_TECHNICAL=technical
VITE_ROBOGUIDE_MODE_NON_TECHNICAL=non-technical
